<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>orbbec_bev_odometry</name>
  <version>0.0.0</version>
  <description>BEV odometry node for an Orbbec Femto Bolt depth camera.</description>
  <maintainer email="oit@todo.todo">oit</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>tf2_ros</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-scipy</exec_depend>
  <build_depend>libpcl-dev</build_depend>
  <build_depend>pybind11-dev</build_depend>
  <build_depend>pkg-config</build_depend>
  <exec_depend>orbbec_camera</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
